[Desktop Entry]
Version=1.0
Name=Firefox
GenericName=Web Browser
Comment=Browse the web
Exec=/usr/local/libexec/udroid/firefox %u
Icon=/opt/firefox/browser/chrome/icons/default/default128.png
Terminal=false
Type=Application
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=firefox
Actions=new-window;private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/local/libexec/udroid/firefox --new-window

[Desktop Action private-window]
Name=New Private Window
Exec=/usr/local/libexec/udroid/firefox --private-window
