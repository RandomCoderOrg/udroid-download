#!/bin/sh
set -eu

export LC_ALL=C

if [ "$(dpkg --print-architecture)" != arm64 ]; then
    echo "The Chromium installer supports ARM64 only" >&2
    exit 1
fi

apt-get install -y --no-install-recommends debian-archive-keyring
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
chmod 0755 "$workdir"
mkdir -p "$workdir/lists/partial"

# Keep Debian metadata out of Ubuntu's normal dependency resolution.
cat > "$workdir/sources.list" <<'EOF'
deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://deb.debian.org/debian trixie main
deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://security.debian.org/debian-security trixie-security main
EOF
set -- \
    -o "Dir::Etc::sourcelist=$workdir/sources.list" \
    -o Dir::Etc::sourceparts=- \
    -o "Dir::State::lists=$workdir/lists" \
    -o Dir::Cache::pkgcache= \
    -o Dir::Cache::srcpkgcache=
apt-get "$@" update --error-on=any
version=$(apt-cache "$@" policy chromium | awk '/Candidate:/ {print $2}')
if [ -z "$version" ] || [ "$version" = '(none)' ]; then
    echo "No Debian Chromium candidate is available" >&2
    exit 1
fi

# APT checks downloads against the authenticated package metadata.
(
    cd "$workdir"
    apt-get "$@" download "chromium=$version" "chromium-common=$version" libjpeg62-turbo
)
apt-get install -y --no-install-recommends "$workdir/"*.deb
dpkg-query -W chromium chromium-common
