#!/bin/sh
set -eu

session_pid=$(pgrep -u "$(id -u)" -x plasmashell | head -n 1 || true)
if [ -z "$session_pid" ]; then
    echo "No Plasma desktop session is running" >&2
    exit 1
fi

session_environment=$(tr '\0' '\n' < "/proc/$session_pid/environ")

copy_session_variable() {
    name=$1
    value=$(printf '%s\n' "$session_environment" |
        sed -n "s/^${name}=//p" | head -n 1)
    if [ -n "$value" ]; then
        export "$name=$value"
    fi
}

for name in \
    DBUS_SESSION_BUS_ADDRESS DISPLAY XDG_RUNTIME_DIR \
    DESKTOP_SESSION KDEWM KDE_APPLICATIONS_AS_SCOPE KDE_FULL_SESSION \
    KDE_SESSION_UID KDE_SESSION_VERSION QT_QPA_PLATFORM \
    XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_MENU_PREFIX \
    XDG_SESSION_CLASS XDG_SESSION_DESKTOP XDG_SESSION_TYPE
do
    copy_session_variable "$name"
done

exec "$@"
